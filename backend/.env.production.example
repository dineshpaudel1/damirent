# Copy this file to .env.production and fill in every value before deploying.
# NEVER commit .env.production to git.

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
ALLOWED_HOSTS=api.damirent.com
CORS_ALLOWED_ORIGINS=https://api.damirent.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=damirent
DB_USER=damirent
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=DamiRent <noreply@damirent.com>

# ── Payment — Khalti ──────────────────────────────────────────────────────────
# Sandbox:    get from https://test-admin.khalti.com
# Production: get from https://admin.khalti.com  (after KYC approval)
KHALTI_SECRET_KEY=your-khalti-secret-key

# ── AWS S3 (for media/document storage) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=damirent-media
AWS_S3_REGION_NAME=ap-south-1

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── Business ──────────────────────────────────────────────────────────────────
VERIFICATION_ADMIN_EMAIL=admin@damirent.com
